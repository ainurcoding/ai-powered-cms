# Template untuk Google OAuth Configuration
# Copy isi file ini ke .env dan isi dengan credentials yang benar

# Google OAuth Configuration (for social login)
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/
# 1. Buat project baru
# 2. Aktifkan Google+ API dan OAuth2 API  
# 3. Buat OAuth 2.0 Client ID
# 4. Set Authorized redirect URIs: http://localhost:8000/auth/google/callback

GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Contoh format yang benar:
# GOOGLE_OAUTH_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/auth/google/callback
