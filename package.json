{
	"name": "ai-cms-backend",
	"version": "1.0.0",
	"main": "index.ts",
	"scripts": {
		"prepare": "husky || true",
		"build": "if exist dist rmdir /s /q dist && npx tsc",
		"start": "node dist/index.js",
		"start:docker": "docker build -t ai_cms_backend:latest . && docker compose up -d",
		"stop:docker": "docker compose down",
		"dev": "tsx watch ./src/index.ts",
		"lint": "eslint --fix **/*.ts",
		"test": "jest"
	},
	"keywords": [
		"typescript",
		"express",
		"rest-api",
		"ai-cms-backend"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@types/multer": "^2.0.0",
		"bcryptjs": "~2.4.3",
		"cloudinary": "^2.8.0",
		"compression": "^1.7.4",
		"cors": "^2.8.5",
		"dotenv": "~16.4.5",
		"express": "^4.19.2",
		"express-jsdoc-swagger": "^1.8.0",
		"helmet": "^7.1.0",
		"jsonwebtoken": "~9.0.0",
		"lodash": "^4.17.21",
		"module-alias": "~2.2.3",
		"moment": "^2.30.1",
		"morgan": "^1.10.0",
		"multer": "^2.0.2",
		"pg": "^8.12.0",
		"socket.io": "^4.7.5",
		"tslib": "~2.6.2",
		"valibot": "^0.36.0",
		"winston": "^3.14.2"
	},
	"devDependencies": {
		"@babel/core": "~7.23.7",
		"@babel/plugin-proposal-decorators": "~7.23.7",
		"@babel/preset-env": "~7.23.7",
		"@babel/preset-typescript": "~7.23.3",
		"@types/babel__core": "~7.20.5",
		"@types/babel__preset-env": "~7.9.6",
		"@types/bcryptjs": "~2.4.2",
		"@types/compression": "^1.7.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jest": "~29.5.11",
		"@types/jsonwebtoken": "~9.0.2",
		"@types/module-alias": "~2.0.4",
		"@types/morgan": "^1.9.9",
		"@types/node": "~20.10.4",
		"@types/pg": "^8.11.10",
		"babel-jest": "~29.7.0",
		"eslint": "~8.56.0",
		"eslint-config-love": "~57.0.0",
		"husky": "~9.1.1",
		"jest": "~29.7.0",
		"module-alias-jest": "~0.0.3",
		"tsx": "~4.16.2",
		"typescript": "~5.5.4"
	},
	"_aliases": {
		"@": "./src/",
		"@http": "./src/app/http/",
		"@httpController": "./src/app/http/controller/",
		"@repositories": "./src/repositories/",
		"@libs": "./src/libs/",
		"@services": "./src/services/"
	}
}
