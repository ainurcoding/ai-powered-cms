# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ai_cms_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI Configuration
# Google Gemini API (for content generation and SEO optimization)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Vertex AI (for image generation with Imagen 4)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Alternative Image Generation APIs
HUGGING_FACE_API_KEY=your_hugging_face_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Settings
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_IMAGE_QUALITY=standard
AI_IMAGE_STYLE=photographic
AI_RATE_LIMIT=60
AI_RATE_LIMIT_HOUR=1000

# Server Configuration
PORT=8000
NODE_ENV=development