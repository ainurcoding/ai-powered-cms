# ===========================================
# AI-Powered CMS Backend - Environment Variables
# ===========================================

# Application Configuration
APP_PORT_HTTP=8000
NODE_ENV=development
APP_SECRET_KEY=your_secret_key_here
APP_EXPOSE_DOCS=true

# Database PostgreSQL Configuration
DB_HOST_POSTGRES=localhost
DB_NAME_POSTGRES=ai_cms_db
DB_USER_POSTGRES=postgres
DB_PASS_POSTGRES=postgres
DB_PORT_POSTGRES=5432

# RabbitMQ Configuration (Optional - for future use)
RABBITMQ_URL=
RABBITMQ_EXCHANGE=

# Cloudinary Configuration (Media Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=ai-cms

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp

# ===========================================
# Setup Instructions:
# ===========================================
# 1. Copy this file to .env
# 2. Update the values according to your setup
# 3. Make sure PostgreSQL is running
# 4. Create database: ai_cms_db
# 5. Run migrations: database/migrations/
# ===========================================

# ===========================================
# Database Setup Commands:
# ===========================================
# Create database:
# podman exec -it postgres_16 psql -U postgres -c "CREATE DATABASE ai_cms_db;"
#
# Run migrations:
# podman exec -i postgres_16 psql -U postgres -d ai_cms_db < database/migrations/002_create_users_table_uuid.sql
# ===========================================

# ===========================================
# Security Notes:
# ===========================================
# - Change APP_SECRET_KEY to a strong random string
# - Use strong passwords for database
# - Don't commit .env file to version control
# ===========================================
